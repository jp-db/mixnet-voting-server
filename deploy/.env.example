# Copy to deploy/.env and fill in. Generate each value with:
#   tokens: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   KEKs:   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Back up the KEKs: losing one makes that node's election keys unrecoverable.
BALLOT_BOX_SECRET_KEY=
MIXNET_NODE_0_API_TOKEN=
MIXNET_NODE_0_KEK=
MIXNET_NODE_1_API_TOKEN=
MIXNET_NODE_1_KEK=
MIXNET_NODE_2_API_TOKEN=
MIXNET_NODE_2_KEK=
